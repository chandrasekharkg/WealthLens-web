  "info": {
    "title": "WealthLens",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/jobs": {
      "post": {
        "description": "Run a WLC verb against exactly one named, manifest-declared workspace.\n\nThere is no \"run against all\": each store has its own gates, its own key and its own lock, and a\nfan-out would hide which one refused.",
        "operationId": "start_job_api_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Body",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Job"
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "operationId": "job_status_api_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Job Status"
      }
    },
    "/api/jobs/{job_id}/stream": {
      "get": {
        "description": "Watch a running verb as server-sent events.\n\nThe stream carries the verb's own narration as OPAQUE lines. Only `import` publishes structure\nmid-run, so parsing prose into a progress bar would mean inventing a contract that does not exist\nand breaking it on the next copy edit upstream. Lines now, structure when the engine offers it.\n\nThe stream is a convenience, never the record: the outcome stays retrievable from the job endpoint\nafter the stream closes, so a viewer who navigates away or reconnects still learns what happened.",
        "operationId": "job_stream_api_jobs__job_id__stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Job Stream"
      }
    },
