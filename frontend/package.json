{
  "name": "wealthlens-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e:install": "playwright install --with-deps chromium",
    "check": "npm run lint && npm run typecheck && npm test",
    "types": "openapi-typescript src/api/openapi.json -o src/api/types.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
